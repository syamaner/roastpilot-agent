# roastpilot-agent appliance environment (issue #138, E11-S2)
#
# Mode 0600, owned by the operator. Loaded by systemd via
# EnvironmentFile=/etc/roastpilot-agent/roastpilot-agent.env (see
# roastpilot-agent.service) — restart the service after editing this file.
#
# The installer never defaults, echoes, or logs a credential value: paste a
# real key below by hand. With no key set, roastpilot-agent still starts —
# the controller keeps driving safety with no advice (AGENTS.md: the advisor
# is advisory-only and never controls hardware).
OPENROUTER_API_KEY=

# HTTP bind port. The service uses the same renderer-validated value directly
# in ExecStart, so changing this line later requires re-rendering the unit.
PORT=@@PORT@@

# Persistent SQLite decision-trace path (survives a restart so recovery can
# read prior run state — see ROASTPILOT_DB in `roastpilot-agent --help`).
ROASTPILOT_DB=@@DB_PATH@@

# coffee-roaster-mcp child config path — the appliance's pi_inference
# profile. Forwarded to the spawned MCP child unchanged (see
# roastpilot_agent.mcp_yaml / roastpilot_agent.live.forward_coffee_env).
COFFEE_ROASTER_MCP_CONFIG=@@MCP_CONFIG_PATH@@
